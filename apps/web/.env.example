# Copy to .env.local (git-ignored). Both values are PUBLIC by design.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# The publishable (anon) key from Project Settings -> API. NEVER the service_role / secret key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Where the API runs (defaults to http://localhost:8000)
# NEXT_PUBLIC_API_URL=http://localhost:8000
