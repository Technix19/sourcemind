# Copy to .env (git-ignored). Never commit real values.
APP_ENV=local
FRONTEND_ORIGIN=http://localhost:3000

# Optional overrides (defaults shown)
# MAX_UPLOAD_BYTES=12582912
# MAX_PDF_PAGES=150
# MAX_DOCUMENTS=12
# CHUNK_SIZE=950
# CHUNK_OVERLAP=170
# MIN_RELEVANCE_SCORE=0.05

# Optional answer generation with Claude (off unless BOTH are set). Server-side only.
# ANTHROPIC_API_KEY=         # from console.anthropic.com. Never commit it.
# ANTHROPIC_MODEL=           # e.g. claude-haiku-5-5 (cheapest), claude-sonnet-5-5, claude-opus-5-5
# ANTHROPIC_EFFORT=low       # low|medium|high|xhigh|max. Empty = omit (older models only)
# MAX_CONTEXT_CHARS=8000     # evidence characters sent to the model
# MAX_ANSWER_TOKENS=2000     # output cap per answer; includes the model's thinking

# Supabase (M6). Create these in YOUR project; keep real values only in the git-ignored .env.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=        # the publishable (anon) key. NEVER the service-role key.

# Meaning search (M6d): a local model, no key needed. First use downloads about 64 MB once.
# EMBEDDINGS_ENABLED=true
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5   # must produce 384-dimension vectors
# EMBEDDING_CACHE_DIR=                      # default ~/.cache/sourcemind/models
# MIN_EMBEDDING_SCORE=0.5                   # PROVISIONAL, untuned (M7 measures it)

# Per-user limits (M7c). Non-positive or invalid values fall back to the defaults shown.
# RATE_QUERIES_PER_MINUTE=30
# RATE_UPLOADS_PER_HOUR=10
# RATE_OTHER_PER_MINUTE=120
# DAILY_GENERATIONS=20      # paid model calls per user per rolling 24 hours
# STALE_UPLOAD_MINUTES=15   # an upload still 'indexing' after this long is treated as abandoned and removed
