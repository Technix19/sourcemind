# Copy to .env (git-ignored). Never commit real values.
APP_ENV=local
FRONTEND_ORIGIN=http://localhost:3000

# Optional overrides (defaults shown)
# MAX_UPLOAD_BYTES=12582912
# MAX_PDF_PAGES=150
# MAX_DOCUMENTS=12
# CHUNK_SIZE=950
# CHUNK_OVERLAP=170
# MIN_RELEVANCE_SCORE=0.05

# Optional answer generation (off unless BOTH are set). Server-side only.
# OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=        # a model your account can use
# MAX_CONTEXT_CHARS=8000    # evidence characters sent to the model
# MAX_ANSWER_TOKENS=500     # caps cost per answer

# Supabase (M6). Create these in YOUR project; keep real values only in the git-ignored .env.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=        # the publishable (anon) key. NEVER the service-role key.
